# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build Output ─────────────────────────────────────────────────────────────
dist/
dist-ssr/
build/

# ─── Test & Coverage ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo
node_modules/.tmp/

# ─── Vite ─────────────────────────────────────────────────────────────────────
.vite/

# ─── Environment Variables ───────────────────────────────────────────────────
# Keep .env.example but ignore real secrets
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Package Manager Locks (keep the one you use, ignore others) ──────────────
# We use npm, so keep package-lock.json and ignore the rest:
yarn.lock
pnpm-lock.yaml
.yarn/

# ─── Editor & OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
.vscode/*
# Allow shared VS Code settings to be committed
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# ─── Misc ────────────────────────────────────────────────────────────────────
*.local
.cache/
